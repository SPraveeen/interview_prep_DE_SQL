   "source": [
    "declare @today_date;\n",
    "DECLARE @n int;\n",
    "set @today_date='2022-01-01' --saturday\n",
    "set @n=3;\n",
    "\n",
    "select dateadd(week,@n-1,dateadd(day,8-DATEPART(weekday,@today_date),@today_date))"
   ]
